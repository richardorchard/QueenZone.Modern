// Merge into app.json (Expo). Place the files under assets/icon/.
{
  "expo": {
    "icon": "./assets/icon/AppIcon-1024.png",
    "ios": {
      "icon": "./assets/icon/AppIcon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/ic_launcher_foreground.png",
        "monochromeImage": "./assets/icon/ic_launcher_monochrome.png",
        "backgroundColor": "#111111"
      }
    },
    "notification": {
      "icon": "./assets/icon/ic_notification.png",
      "color": "#B89A4A"
    }
  }
}
