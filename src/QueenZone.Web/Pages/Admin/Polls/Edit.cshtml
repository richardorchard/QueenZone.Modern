@page "/admin/polls/{id:guid}/edit"
@model EditModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  ViewData["AntiforgeryToken"] = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<div class="admin-shell">
@if (Model.Form is not null)
{
  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <p class="admin-status admin-status--@Model.StatusMessageKind">@Model.StatusMessage</p>
  }
  <partial name="_PollForm" model="Model.Form" />
}
</div>
