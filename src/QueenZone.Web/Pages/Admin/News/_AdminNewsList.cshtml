@model QueenZone.Web.Pages.Admin.News.AdminNewsListViewModel

<h1>Admin news</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
  <p class="admin-status admin-status--@Model.StatusMessageKind">@Model.StatusMessage</p>
}

<div class="qz-table-bar">
  <div class="qz-table-bar__count">
    @if (Model.TotalCount > 0)
    {
      @:Showing @Model.RangeStart&ndash;@Model.RangeEnd of @Model.TotalCount articles
    }
    else
    {
      @:No news articles yet
    }
  </div>
  <div class="qz-table-bar__controls">
    <a class="qz-button qz-button--outline qz-button--sm" href="/admin/news/new">Create article</a>
    <a class="qz-button qz-button--ghost qz-button--sm" href="/admin/news-discovery">Review discovered candidates</a>
    <a class="qz-button qz-button--ghost qz-button--sm" href="/admin/news-suggestions">Review news suggestions</a>
    <a class="qz-button qz-button--ghost qz-button--sm" href="/admin/photo-submissions">Review photo submissions</a>
  </div>
</div>

@if (Model.Articles.Count == 0)
{
  <p>No news articles yet.</p>
}
else
{
  <div class="qz-table-shell">
    <div class="qz-table-scroll">
      <table class="admin-table--qz">
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Published</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var article in Model.Articles)
          {
            <tr>
              <td class="admin-title-cell"><a href="/admin/news/@article.Id/edit">@article.Title</a></td>
              <td>
                @if (article.IsPublished)
                {
                  <span class="qz-status is-published">Published</span>
                }
                else
                {
                  <span class="qz-status is-draft">Draft</span>
                }
              </td>
              <td>@article.PublishedAt.ToString("dd MMM yyyy")</td>
              <td>
                <div class="qz-row-actions">
                  <a class="qz-button qz-button--ghost qz-button--row" href="/admin/news/@article.Id/edit">Edit</a>
                  @if (article.IsPublished)
                  {
                    <partial name="_PostAction" model="@(new PostActionViewModel($"/admin/news/{article.Id}/unpublish", "Unpublish", AntiforgeryToken: Model.AntiforgeryToken))" />
                  }
                  else
                  {
                    <partial name="_PostAction" model="@(new PostActionViewModel($"/admin/news/{article.Id}/publish", "Publish", AntiforgeryToken: Model.AntiforgeryToken))" />
                  }
                  <partial name="_PostAction" model="@(new PostActionViewModel($"/admin/news/{article.Id}/delete", "Delete", Confirm: true, AntiforgeryToken: Model.AntiforgeryToken, ConfirmItemName: article.Title, IsDanger: true))" />
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  <partial name="_ArchivePagination" model="Model.Pagination" />
}
