@model QueenZone.Web.Pages.Admin.News.ArticleFormViewModel
@using Microsoft.Extensions.Options
@using QueenZone.Storage
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IOptions<BlobUploadOptions> BlobUploadOptions
@{
  var antiforgeryToken = (ViewData["AntiforgeryToken"] as string)
    ?? Antiforgery.GetAndStoreTokens(Context).RequestToken;
  var articleImageMaxBytes = BlobUploadOptions.Value.Containers.TryGetValue(BlobUploadContainers.Articles, out var articlePolicy)
      && articlePolicy.MaxBytes is > 0
    ? articlePolicy.MaxBytes.Value
    : NewsArticleImageProcessor.MaxUploadBytes;
  articleImageMaxBytes = Math.Min(articleImageMaxBytes, NewsArticleImageProcessor.MaxUploadBytes);
}
<link rel="stylesheet" href="~/css/admin/cropper.min.css" asp-append-version="true" />

<div class="admin-form-panel" data-gallery-picker-host>
<h1>@Model.Title</h1>
@if (!string.IsNullOrWhiteSpace(Model.Subtitle))
{
  <p class="admin-article-subtitle">@Model.Subtitle</p>
}

@if (Model.DiscoveryProvenance is not null)
{
  <partial name="_DiscoveryProvenance" model="Model.DiscoveryProvenance" />
}

@if (Model.Errors is { Count: > 0 })
{
  <ul class="admin-errors">
    @foreach (var error in Model.Errors)
    {
      <li>@error</li>
    }
  </ul>
}

<form method="post" action="@Model.Action" class="admin-form" enctype="multipart/form-data">
  <input type="hidden" name="@AdminNewsPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken">
  @if (Model.Article?.UpdatedAt is DateTime updatedAt)
  {
    <input type="hidden" name="expectedUpdatedAt" value="@updatedAt.ToUniversalTime().ToString("o")">
  }
  <label>
    Title
    <input type="text" name="title" value="@Model.Draft.Title" maxlength="@NewsValidation.MaxTitleLength" required>
  </label>
  <label>
    Slug
    <input type="text" name="slug" value="@Model.Draft.Slug" placeholder="@NewsSlug.Resolve(Model.Draft.Title, null)" maxlength="@NewsSlug.MaxLength">
  </label>
  <p class="admin-help">Leave blank to auto-generate from the title.</p>
  <label>
    Excerpt
    <input type="text" name="excerpt" value="@Model.Draft.Excerpt" maxlength="@NewsValidation.MaxExcerptLength" required>
  </label>
  @{
    ViewData["TextareaId"] = "body";
    ViewData["TextareaName"] = "body";
    ViewData["EditorValue"] = Model.Draft.Body;
    ViewData["UploadContainer"] = BlobUploadContainers.News;
    ViewData["EditorLabel"] = "Body";
    ViewData["ShowCodeView"] = true;
  }
  <partial name="_RichTextEditor" />
  <label>
    Publication date
    <input type="date" name="publishedAt" value="@Model.Draft.PublishedAt.ToString("yyyy-MM-dd")" required>
  </label>
  <label>
    Source URL
    <input type="text" name="sourceUrl" value="@Model.Draft.SourceUrl" maxlength="@NewsValidation.MaxSourceUrlLength">
  </label>
  <input type="hidden" name="imageBlobKey" value="@Model.Draft.ImageBlobKey" data-article-image-blob-key>
  <input type="hidden" name="imageGalleryPicId" value="@Model.Draft.ImageGalleryPicId" data-article-image-gallery-id>
  @{
    var previewImageUrl = !string.IsNullOrWhiteSpace(Model.PreviewImageUrl)
      ? Model.PreviewImageUrl
      : NewsArticleImage.ResolveDisplayUrl(Model.Draft.ImageBlobKey, Model.Draft.ImageGalleryPicId);
    var hasArticleImage = !string.IsNullOrWhiteSpace(Model.PreviewImageUrl)
      || NewsArticleImage.HasResolvedImage(Model.Draft.ImageBlobKey, Model.Draft.ImageGalleryPicId);
  }
  <div class="admin-article-image-upload"
       data-article-image-crop
       data-gallery-picker
       data-aspect-width="@NewsArticleImageProcessor.CardAspectWidth"
       data-aspect-height="@NewsArticleImageProcessor.CardAspectHeight"
       data-min-crop-width="@NewsArticleImageProcessor.MinCropWidth"
       data-min-crop-height="@NewsArticleImageProcessor.MinCropHeight"
       data-max-bytes="@articleImageMaxBytes">
    <figure class="admin-article-image">
      <img src="@previewImageUrl"
           alt="@(hasArticleImage ? "Article image" : "No article image")"
           width="600"
           height="400"
           data-article-image-preview>
      @if (!hasArticleImage)
      {
        <figcaption class="admin-help">No article image yet. Listings will use this placeholder.</figcaption>
      }
    </figure>
    <label>
      Article image
      <input type="file"
             name="articleImage"
             accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
             data-article-image-input>
    </label>
    <p class="admin-help">JPEG, PNG, or WebP. Max 10&nbsp;MB. Crop to the 3:2 news-card frame before saving.</p>
    <p>
      <button type="button" data-gallery-picker-open data-gallery-picker-url="@NewsArticleGalleryPicker.Path">Choose from gallery</button>
    </p>
    <p class="admin-help">Or choose a library photo and crop it to the 3:2 card. The gallery original is not changed.</p>
    <p class="admin-article-image-error" data-article-image-error hidden></p>
    <input type="hidden" name="cropX" data-crop-x value="">
    <input type="hidden" name="cropY" data-crop-y value="">
    <input type="hidden" name="cropWidth" data-crop-width value="">
    <input type="hidden" name="cropHeight" data-crop-height value="">
    <dialog class="admin-article-crop" data-article-image-dialog>
      <h2 class="admin-article-crop__title">Crop article image</h2>
      <p class="admin-help">Drag to frame the 3:2 card. Zoom to tighten the crop.</p>
      <div class="admin-article-crop__stage" data-article-image-stage>
        <img alt="" data-article-image-stage-img>
      </div>
      <label class="admin-article-crop__zoom">
        Zoom
        <input type="range" min="1" max="3" step="any" value="1" data-article-image-zoom>
      </label>
      <div class="admin-form-actions">
        <button type="button" data-article-image-apply>Use this crop</button>
        <button type="button" data-article-image-cancel>Cancel</button>
      </div>
    </dialog>
  </div>

  <div class="admin-form-actions">
    <button type="submit">Save</button>
    <a href="/admin/news">Cancel</a>
    @if (Model.Article is not null)
    {
      <span>|</span>
      <a href="/admin/news/@Model.Article.Id/preview">Preview</a>
    }
  </div>
</form>

<dialog class="admin-gallery-picker" data-gallery-picker-dialog>
  <div class="admin-gallery-picker__header">
    <h2 class="admin-gallery-picker__title">Choose a gallery photo</h2>
    <button type="button" data-gallery-picker-close>Close</button>
  </div>
  <div data-gallery-picker-panel></div>
</dialog>

@if (Model.Article is not null)
{
  <div class="admin-form-actions admin-form-actions--secondary">
    @if (Model.Article.IsPublished)
    {
      <partial name="_PostAction" model="@(new PostActionViewModel($"/admin/news/{Model.Article.Id}/unpublish", "Unpublish", AntiforgeryToken: antiforgeryToken))" />
    }
    else
    {
      <partial name="_PostAction" model="@(new PostActionViewModel($"/admin/news/{Model.Article.Id}/publish", "Publish", AntiforgeryToken: antiforgeryToken))" />
    }
  </div>
}
</div>
<script src="~/js/admin/cropper.min.js" asp-append-version="true"></script>
<script src="~/js/admin/article-image-crop.js" asp-append-version="true"></script>
<script src="~/js/admin/article-gallery-picker.js" asp-append-version="true"></script>
