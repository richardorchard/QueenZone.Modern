@model QueenZone.Web.Pages.Admin.News.PostActionViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var buttonClass = "qz-button qz-button--ghost qz-button--row" + (Model.IsDanger ? " qz-button--row-danger" : "");
  var token = Model.AntiforgeryToken ?? Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
@if (Model.Confirm)
{
  var dialogId = "confirm-" + Guid.NewGuid().ToString("N");
  <form method="post" action="@Model.Action" class="admin-inline-form">
    <input type="hidden" name="@AdminNewsPageModel.AntiforgeryTokenFieldName" value="@token">
    <button type="button" class="@buttonClass" data-confirm-dialog-open="@dialogId">@Model.Label</button>
    <dialog class="qz-dialog" id="@dialogId" data-confirm-dialog>
      <h2>@Model.Label this article?</h2>
      <p>
        @if (!string.IsNullOrWhiteSpace(Model.ConfirmItemName))
        {
          @:&ldquo;@Model.ConfirmItemName&rdquo; will be permanently removed. This cannot be undone.
        }
        else
        {
          @:This cannot be undone.
        }
      </p>
      <div class="qz-dialog-actions">
        <button type="button" class="qz-button qz-button--outline" data-confirm-dialog-cancel>Cancel</button>
        <button type="submit" class="qz-button qz-button--danger">@Model.Label</button>
      </div>
    </dialog>
  </form>
}
else
{
  <form method="post" action="@Model.Action" class="admin-inline-form">
    <input type="hidden" name="@AdminNewsPageModel.AntiforgeryTokenFieldName" value="@token">
    <button type="submit" class="@buttonClass">@Model.Label</button>
  </form>
}
