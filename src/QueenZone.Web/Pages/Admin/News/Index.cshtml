@page "/admin/news"
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<div class="admin-shell">
<partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
@if (Model.CreateForm is not null)
{
  ViewData["AntiforgeryToken"] = antiforgeryToken;
  <partial name="_ArticleForm" model="Model.CreateForm" />
}
else
{
  <partial name="_AdminNewsList" model="AdminNewsListViewModel.FromPageModel(Model, antiforgeryToken ?? string.Empty)" />
}
</div>
