@model IReadOnlyList<QueenZone.Data.PhotoItem>
@using QueenZone.Data
@{
  var filter = ViewData["PhotoListFilter"] as PhotoListFilter ?? PhotoListFilter.None;
}

<div class="qz-photo-grid">
  @foreach (var photo in Model)
  {
    var detailHref = PhotoRoutes.GetDetailPath(photo.CategorySlug, photo.PicId, filter);
    <figure class="qz-photo-thumb">
      <a href="@detailHref">
        <img
          src="@photo.ThumbnailUrl"
          alt="@photo.Title"
          width="@photo.ThumbWidth"
          height="@photo.ThumbHeight"
          loading="lazy">
      </a>
      <figcaption>
        <a class="qz-photo-thumb__title" href="@detailHref">@photo.Title</a>
        <span class="qz-photo-thumb__meta">
          @photo.Year
          @if (photo.PictureDimensionsLabel is string dimensions)
          {
            <text> · @dimensions</text>
          }
        </span>
      </figcaption>
    </figure>
  }
</div>
