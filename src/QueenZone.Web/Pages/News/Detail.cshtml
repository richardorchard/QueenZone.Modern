@page "/news/{id:int}/{slug}"
@model DetailModel

@section Head {
  @if (!string.IsNullOrWhiteSpace(Model.StructuredDataJson))
  {
    <script type="application/ld+json" nonce="@HttpContext.GetCspNonce()">@Html.Raw(Model.StructuredDataJson)</script>
  }
}

@if (Model.Item is not null)
{
  <section class="qz-article-hero">
    <partial name="_PictureImage" model="@("/design-system/assets/img-hero.jpg", "", false, (string?)null)" />
    <div class="qz-container qz-article-hero__content qz-breadcrumbs-on-dark">
      <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
      <div class="qz-eyebrow">News archive</div>
      <h1>@Model.Item.Title</h1>
      <div class="qz-meta">
        @if (Model.Item.SubmitterMemberId is Guid submitterMemberId && !string.IsNullOrWhiteSpace(Model.Item.SubmitterDisplayName))
        {
          <span>Submitted by <a class="qz-attribution-link" href="/members/@submitterMemberId">@Model.Item.SubmitterDisplayName</a> &middot; </span>
        }
        <time datetime="@Model.Item.PublishedAt.ToString("yyyy-MM-dd")">@Model.Item.PublishedAt.ToString("dd MMMM yyyy")</time>
      </div>
    </div>
  </section>
  <div class="qz-reading">
    <p class="lede">@Model.Item.Excerpt</p>
    <article class="article-body">@Html.Raw(NewsArticleContent.FormatBody(Model.Item.Body))</article>

    @if (NewsArticleContent.IsSafePublicUrl(Model.Item.SourceUrl))
    {
      <p class="article-source">Source: <a href="@Model.Item.SourceUrl" rel="noopener noreferrer">@Model.Item.SourceUrl</a></p>
    }
    <partial name="_SocialShare" />
  </div>
}
