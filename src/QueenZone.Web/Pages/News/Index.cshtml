@page "/news"
@model IndexModel

<partial name="_PageHero" model='@(("The Archive", "News", "Chronological entries from the preserved Queenzone.com archive, with space for newly approved news articles.", "4,000+ articles"))' />

<section class="qz-section">
  <div class="qz-container">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
    <form method="get" action="/news/search" style="margin-bottom: var(--space-5);">
      <div style="display: flex; gap: var(--space-3);">
        <input name="q"
               type="search"
               placeholder="Search the news archive…"
               autocomplete="off"
               aria-label="Search news"
               style="flex: 1; padding: 0.75rem 1rem; border: 1px solid var(--border-strong); border-radius: var(--radius-xs); font: var(--type-body);">
        <button type="submit" class="qz-button" style="white-space: nowrap;">Search</button>
      </div>
    </form>
    <partial name="_NewsArchiveList" model="Model.Items" />

    <partial name="_ArchivePagination" model="NewsRoutes.GetArchivePaginationViewModel(Model.CurrentPage, Model.TotalPages)" />
  </div>
</section>
