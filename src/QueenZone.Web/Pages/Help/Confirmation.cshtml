@page "/help/confirmation"
@model QueenZone.Web.Pages.Help.ConfirmationModel

<partial name="_PageHero" model='@(("Help", "Thank you", "Your message has been sent to the site admin.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    <p class="qz-account-notice qz-account-notice--success" role="status">
      Thanks — we have your help request. The site admin will read it and reply by email if a response is needed.
    </p>
    <p>
      <a href="/help">Send another request</a>
      ·
      <a href="/">Back to the home page</a>
    </p>
  </div>
</section>
