@page "/contact/confirmation"
@model QueenZone.Web.Pages.Help.ConfirmationModel

<partial name="_PageHero" model='@(("Contact", "Thank you", "Your message has been sent to the site admin.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    <p class="qz-account-notice qz-account-notice--success" role="status">
      @ContactCopy.ConfirmationMessage
    </p>
    <p>
      <a href="/contact">Send another message</a>
      ·
      <a href="/">Back to the home page</a>
    </p>
  </div>
</section>
