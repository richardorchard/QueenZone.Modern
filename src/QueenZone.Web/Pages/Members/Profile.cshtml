@page "/members/{memberId:guid}"
@model QueenZone.Web.Pages.Members.ProfileModel

@{
  var name = Model.Member?.DisplayName ?? "Member";
}

<partial name="_PageHero" model='@(("Community", name, "Member profile", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    @if (Model.Member is not null)
    {
      <div class="qz-member-profile">
        <partial name="_MemberAvatar" model="@(new MemberAvatarViewModel { DisplayName = Model.Member.DisplayName, MemberId = Model.Member.Id, HasAvatar = !string.IsNullOrWhiteSpace(Model.Member.AvatarUrl), Size = "lg" })" />
        <h2>@Model.Member.DisplayName</h2>
        <p class="qz-meta">Member since @Model.Member.CreatedAt.ToString("MMMM yyyy")</p>

        @if (Model.CanMessage)
        {
          <p>
            <a class="qz-button qz-button--cta" href="/messages/compose?to=@Model.Member.Id">Message</a>
          </p>
        }
        else if (!Model.IsSignedIn)
        {
          <p>
            <a class="qz-button qz-button--outline" href="/account/login?returnUrl=@Uri.EscapeDataString($"/messages/compose?to={Model.Member.Id}")">Sign in to message</a>
          </p>
        }
      </div>

      <div class="qz-member-activity">
        <h2>Public contributions</h2>
        @if (Model.Activity.Count == 0)
        {
          <p class="qz-meta">No public contributions yet.</p>
        }
        else
        {
          <ol class="qz-member-activity__list">
            @foreach (var item in Model.Activity)
            {
              <li class="qz-member-activity__item">
                <p class="qz-meta"><span class="qz-member-activity__type">@item.Type</span> · <time datetime="@item.PublishedAt.ToString("O")">@item.PublishedAt.ToString("dd MMMM yyyy")</time></p>
                <h3><a href="@item.Href">@item.Title</a></h3>
                @if (!string.IsNullOrWhiteSpace(item.Summary))
                {
                  <p>@item.Summary</p>
                }
              </li>
            }
          </ol>
          @if (Model.Pagination is not null)
          {
            <partial name="_ArchivePagination" model="Model.Pagination" />
          }
        }
      </div>
    }
  </div>
</section>
