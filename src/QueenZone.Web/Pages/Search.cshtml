@page "/search"
@model SearchModel
@using QueenZone.Data
@using QueenZone.Web
@using QueenZone.Web.Search
@{
  ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query)
    ? "Search"
    : $"Search: {Model.Query}";
  ViewData["Description"] = "Search the Queenzone archive — news, articles and forum discussions.";
  ViewData["Robots"] = "noindex,follow";

  var exampleTags = new[] { "Bohemian Rhapsody", "Live Aid 1985", "Freddie Mercury", "Wembley 1986" };

  var filterTypes = new[]
  {
    SiteSearchContentType.News,
    SiteSearchContentType.Forum,
    SiteSearchContentType.Article,
    SiteSearchContentType.LegacyArticle,
    SiteSearchContentType.Biography,
    SiteSearchContentType.Discography,
    SiteSearchContentType.Timeline,
    SiteSearchContentType.FanPerformance,
    SiteSearchContentType.Tribute,
  };

  string BuildSearchLink(string? type, int page = 1)
  {
    var link = $"/search?q={Uri.EscapeDataString(Model.Query ?? string.Empty)}";
    if (type is not null)
    {
      link += $"&type={Uri.EscapeDataString(type)}";
    }
    if (page > 1)
    {
      link += $"&page={page}";
    }
    return link;
  }
}

<partial name="_PageHero" model='@(("Search the Archive", "Search", "Search news, articles and forum discussions.", "News, articles and discussions"))' />

<section class="qz-section">
  <div class="qz-container" style="max-width: 760px;">
    <form method="get" action="/search">
      <label class="qz-eyebrow" for="qz-search">Search query</label>
      <div style="display: flex; gap: var(--space-3); margin-top: var(--space-3);">
        <input id="qz-search"
               name="q"
               type="search"
               value="@Model.Query"
               maxlength="200"
               placeholder="Search news, articles and discussions..."
               autocomplete="off"
               style="flex: 1; min-width: 0; padding: 1rem 1.125rem; border: 1px solid var(--border-strong); border-radius: var(--radius-xs); font: var(--type-body);">
        <button type="submit" class="qz-button" style="white-space: nowrap;">Search</button>
      </div>
      @if (!string.IsNullOrWhiteSpace(Model.ActiveContentType))
      {
        <input type="hidden" name="type" value="@Model.ActiveContentType">
      }
    </form>

    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
      <div class="qz-tag-row" style="margin-top: var(--space-5);">
        @foreach (var tag in exampleTags)
        {
          <a class="qz-tag" href="/search?q=@Uri.EscapeDataString(tag)">@tag</a>
        }
      </div>
    }
  </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Query))
{
  <section class="qz-section">
    <div class="qz-container" style="max-width: 760px;">

      <nav class="qz-tag-row" aria-label="Filter search results by content type">
        <a class="qz-tag @(Model.ActiveContentType is null ? "qz-tag--active" : "")" href="@BuildSearchLink(null)">All</a>
        @foreach (var type in filterTypes)
        {
          <a class="qz-tag @(Model.ActiveContentType == type ? "qz-tag--active" : "")" href="@BuildSearchLink(type)">@SiteSearchContentType.DisplayLabel(type)</a>
        }
      </nav>

      @if (Model.Results is null || Model.Results.TotalCount == 0)
      {
        <p class="qz-meta" style="margin-top: var(--space-4);">No results found for <strong>@Model.Query</strong>. Try different keywords.</p>
      }
      else
      {
        <partial name="_SectionHeader" model="@(($"{Model.Results.TotalCount:N0} result{(Model.Results.TotalCount == 1 ? "" : "s")} for \"{Model.Query}\"", "Search results", false, (string?)null, (string?)null))" />

        <div class="qz-grid qz-grid--two" style="margin-top: var(--space-4);">
          @foreach (var result in Model.Results.Results)
          {
            <a class="qz-card" href="@result.Url">
              <div class="qz-card__kicker">@SiteSearchContentType.DisplayLabel(result.ContentType)</div>
              <h3>@result.Title</h3>
              <p>@SearchResultHighlighter.Highlight(result.Summary, Model.Query!)</p>
              <p class="qz-meta">
                @if (!string.IsNullOrWhiteSpace(result.Category))
                {
                  @result.Category
                  <text> · </text>
                }
                @if (!string.IsNullOrWhiteSpace(result.AuthorDisplayName))
                {
                  @result.AuthorDisplayName
                  <text> · </text>
                }
                @if (result.PublishedAt.HasValue)
                {
                  <time datetime="@result.PublishedAt.Value.ToString("yyyy-MM-dd")">@result.PublishedAt.Value.ToString("dd MMM yyyy")</time>
                }
              </p>
            </a>
          }
        </div>

        var pagination = ArchivePagination.BuildViewModel(
          "Search results pagination",
          Model.CurrentPage,
          Model.TotalPages,
          p => BuildSearchLink(Model.ActiveContentType, p));
        <partial name="_ArchivePagination" model="pagination" />
      }

    </div>
  </section>
}
