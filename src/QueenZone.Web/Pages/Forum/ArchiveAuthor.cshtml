@page "/forum/archive-authors/{legacyUserId:int}"
@model QueenZone.Web.Pages.Forum.ArchiveAuthorModel

@{
  var name = Model.Author?.DisplayName ?? "Archive member";
}

<partial name="_PageHero" model='@(("Forum", name, "Archive member", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    @if (Model.Author is not null)
    {
      <div class="qz-member-profile">
        <partial name="_MemberAvatar" model="@(new MemberAvatarViewModel { DisplayName = Model.Author.DisplayName, Size = "lg" })" />
        <h2>@Model.Author.DisplayName</h2>
        <p class="qz-meta">
          @Model.Author.PostCount.ToString("N0") post@(Model.Author.PostCount == 1 ? "" : "s") in the archive
          @if (Model.Author.MemberSince is DateTime memberSince)
          {
            <text> · Member since @memberSince.ToString("MMMM yyyy")</text>
          }
        </p>
        <p class="qz-meta">This is an archive member from the original forum. Nobody has claimed this account yet.</p>
      </div>

      <div class="qz-member-activity">
        <h2>Posts in the archive</h2>
        @if (Model.Posts.Count == 0)
        {
          <p class="qz-meta">No posts are visible for this member.</p>
        }
        else
        {
          <ol class="qz-member-activity__list">
            @foreach (var item in Model.Posts)
            {
              <li class="qz-member-activity__item">
                <p class="qz-meta"><time datetime="@item.PublishedAt.ToString("O")">@item.PublishedAt.ToString("dd MMMM yyyy")</time></p>
                <h3><a href="@item.Href">@item.Title</a></h3>
                @if (!string.IsNullOrWhiteSpace(item.Summary))
                {
                  <p>@item.Summary</p>
                }
              </li>
            }
          </ol>
          @if (Model.Pagination is not null)
          {
            <partial name="_ArchivePagination" model="Model.Pagination" />
          }
        }
      </div>
    }
  </div>
</section>
