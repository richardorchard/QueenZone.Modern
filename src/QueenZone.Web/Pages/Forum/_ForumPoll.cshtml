@model QueenZone.Data.ForumPollResults
@{
  var poll = Model;
  var returnUrl = Context.Request.Path + Context.Request.QueryString;
  var showResults = !poll.CanViewerVote;
}

<section class="qz-poll qz-forum-poll" id="poll">
  <div class="qz-poll__header">
    <p class="qz-poll__eyebrow">Community Poll</p>
    @if (poll.IsClosed)
    {
      <span class="qz-poll__badge">Closed</span>
    }
  </div>

  <h2 class="qz-poll__question">@poll.Question</h2>

  @if (poll.IsMultiChoice && poll.CanViewerVote)
  {
    <p class="qz-poll__helper">Select all that apply@(poll.MaxChoices is int max ? $" (max {max})" : "")</p>
  }

  @if (poll.CanViewerVote)
  {
    <form method="post" action="/forum/poll/@poll.PollId/vote" class="qz-forum-poll__vote-form">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@returnUrl" />
      <ul class="qz-poll__options">
        @foreach (var option in poll.Options)
        {
          <li>
            <label class="qz-poll__option">
              @if (poll.IsMultiChoice)
              {
                <input class="visually-hidden" type="checkbox" name="optionIds" value="@option.OptionId" />
              }
              else
              {
                <input class="visually-hidden" type="radio" name="optionId" value="@option.OptionId" required />
              }
              <span class="qz-poll__option-content">
                <span class="qz-poll__indicator qz-poll__indicator--@(poll.IsMultiChoice ? "square" : "circle")">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                </span>
                <span class="qz-poll__label">@option.OptionText</span>
              </span>
            </label>
          </li>
        }
      </ul>
      @if (poll.IsMultiChoice)
      {
        <button class="qz-button qz-button--cta qz-button--sm qz-poll__vote-button" type="submit">Cast your vote</button>
      }
      else
      {
        <button class="visually-hidden" type="submit">Vote</button>
      }
    </form>
  }
  else
  {
    <ul class="qz-poll__results">
      @foreach (var option in poll.Options)
      {
        <li class="qz-poll__option qz-poll__option--voted">
          <span class="qz-poll__option-bar qz-poll__option-bar--@(option.SelectedByViewer ? "mine" : "other")" data-bar-width="@(option.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
          <span class="qz-poll__option-content">
            <span class="qz-poll__indicator qz-poll__indicator--@(poll.IsMultiChoice ? "square" : "circle")@(option.SelectedByViewer ? " qz-poll__indicator--mine" : "")">
              @if (option.SelectedByViewer)
              {
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
              }
            </span>
            <span class="qz-poll__label@(option.SelectedByViewer ? " qz-poll__label--mine" : "")">@option.OptionText</span>
            <span class="qz-poll__pct@(option.SelectedByViewer ? " qz-poll__pct--mine" : "")">@option.VoteCount · @option.Percentage.ToString("0.#")%</span>
          </span>
        </li>
      }
    </ul>
    @if (!poll.ViewerHasVoted && !poll.IsClosed)
    {
      <p class="qz-poll__sign-in"><a href="/account/login?returnUrl=@Uri.EscapeDataString(returnUrl)">Sign in to vote</a></p>
    }
  }

  <div class="qz-poll__meta-row">
    <span class="qz-poll__meta">@poll.DistinctVoters.ToString("N0") vote@(poll.DistinctVoters == 1 ? "" : "s")</span>
    <span class="qz-poll__meta">
      @if (poll.IsClosed)
      {
        <text>Closed</text>
      }
      else if (showResults && poll.ViewerHasVoted)
      {
        <text>You voted</text>
      }
      else if (poll.ClosesAt is not null)
      {
        <time datetime="@poll.ClosesAt.Value.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">Closes @poll.ClosesAt.Value.UtcDateTime.ToString("dd MMM yyyy HH:mm") UTC</time>
      }
      else
      {
        <text>Open</text>
      }
    </span>
  </div>

  @if (poll.CanViewerClose)
  {
    <form method="post" action="/forum/poll/@poll.PollId/close" class="qz-forum-poll__close-form">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@returnUrl" />
      <button class="qz-button qz-button--ghost" type="submit">Close poll</button>
    </form>
  }
</section>
