@using Microsoft.Extensions.Options
@model IReadOnlyList<BreadcrumbItem>
@inject IOptions<SiteOptions> SiteOptionsAccessor
@if (Model is { Count: > 1 })
{
  <nav class="qz-breadcrumbs" aria-label="Breadcrumb">
    <ol>
      @for (var i = 0; i < Model.Count; i++)
      {
        var item = Model[i];
        var isCurrent = i == Model.Count - 1;
        <li>
          @if (isCurrent)
          {
            <span aria-current="page">@item.Label</span>
          }
          else
          {
            <a href="@item.Href">@item.Label</a>
          }
        </li>
      }
    </ol>
  </nav>
  // Callers that don't have a real URL for the current page (e.g. Admin
  // edit/detail pages) pass a placeholder "#" for the trailing crumb;
  // resolve it to the actual request path so the JSON-LD doesn't claim
  // the current page's URL is the homepage.
  var jsonLdItems = Model;
  var lastCrumb = Model[Model.Count - 1];
  if (string.IsNullOrEmpty(lastCrumb.Href) || lastCrumb.Href == "#")
  {
    var resolved = new List<BreadcrumbItem>(Model);
    resolved[resolved.Count - 1] = lastCrumb with { Href = Context.Request.Path.Value ?? lastCrumb.Href };
    jsonLdItems = resolved;
  }
  @Html.Raw($"""<script type="application/ld+json" nonce="{Context.GetCspNonce()}">{BreadcrumbJsonLd.Build(jsonLdItems, SiteOptionsAccessor.Value.PublicBaseUrl)}</script>""")
}
