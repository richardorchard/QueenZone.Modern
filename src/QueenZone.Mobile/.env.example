# QueenZone.Mobile — environment overrides (#793)
# Copy to `.env` or `.env.local` (git-ignored). Restart Metro after changes.
#
# EXPO_PUBLIC_APP_ENV selects a committed default API origin:
#   development → http://localhost:5146   (local QueenZone.Web)
#   staging     → https://queenzone-dev.azurewebsites.net
#   production  → https://www.queenzone.org
#
# EXPO_PUBLIC_API_BASE_URL overrides the default for any environment
# (scheme + host + optional port only; do not include /api/v1).

EXPO_PUBLIC_APP_ENV=development

# Examples:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5146
# EXPO_PUBLIC_API_BASE_URL=https://localhost:7162
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5146
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5146
